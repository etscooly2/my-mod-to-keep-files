package com.example.core;


import java.util.ArrayList;
import java.util.List;



public class LivingWorldSave {



    public long worldAge = 0;



    public int population = 10;



    public int civilizationLevel = 0;



    public int forestLevel = 100;



    public int animalPopulation = 50;



    public int resources = 100;



    public List<Settlement> settlements =
            new ArrayList<>();





    public void tick() {


        worldAge++;


    }





    public void dailyUpdate() {



        if(forestLevel < 100) {


            forestLevel++;


        }



        if(forestLevel > 50) {


            animalPopulation++;


        }



        if(resources < 100) {


            resources++;


        }




        SettlementManager.dailyUpdate(this);



        civilizationLevel =
                settlements.size();



    }


}

package com.example.core;

import java.util.EnumMap;
import java.util.Map;

public class Settlement {

    private final String name;

    private int population;
    private int level;

    private final int x;
    private final int z;

    private int food;
    private int wood;
    private int stone;

    private int houses;

    private final Map<Profession, Integer> professions =
            new EnumMap<>(Profession.class);

    public Settlement(String name, int x, int z) {

        this.name = name;

        population = 5;
        level = 1;

        this.x = x;
        this.z = z;

        food = 50;
        wood = 25;
        stone = 10;

        houses = 2;

        for (Profession profession : Profession.values()) {
            professions.put(profession, 0);
        }

        professions.put(Profession.FARMER, 2);
        professions.put(Profession.LUMBERJACK, 1);
        professions.put(Profession.MINER, 1);
        professions.put(Profession.UNEMPLOYED, 1);
    }

    public void dailyUpdate(LivingWorldSave data) {

        assignJobs();

        gatherResources();

        buildHouses();

        consumeFood();

        checkGrowth();
    }

    private void assignJobs() {

        while (professions.get(Profession.UNEMPLOYED) > 0) {

            Profession needed = getMostNeededProfession();

            professions.put(
                    Profession.UNEMPLOYED,
                    professions.get(Profession.UNEMPLOYED) - 1
            );

            professions.put(
                    needed,
                    professions.get(needed) + 1
            );

            System.out.println(
                    "[LivingWorld] " +
                    name +
                    " assigned a new " +
                    needed
            );
        }
    }

    private Profession getMostNeededProfession() {

        if (food < population * 3) {
            return Profession.FARMER;
        }

        if (wood < 50) {
            return Profession.LUMBERJACK;
        }

        if (stone < 30) {
            return Profession.MINER;
        }

        if (level >= 2 &&
                professions.get(Profession.BUILDER) < 2) {
            return Profession.BUILDER;
        }

        if (level >= 3 &&
                professions.get(Profession.BLACKSMITH) < 1) {
            return Profession.BLACKSMITH;
        }

        return Profession.FARMER;
    }

    private void gatherResources() {

        food += professions.get(Profession.FARMER) * 3;

        wood += professions.get(Profession.LUMBERJACK) * 2;

        stone += professions.get(Profession.MINER) * 2;
    }

    private void buildHouses() {

        int builders = professions.get(Profession.BUILDER);

        if (builders == 0) {
            return;
        }

        if (wood >= 25 && stone >= 10) {

            wood -= 25;
            stone -= 10;

            houses++;

            System.out.println(
                    "[LivingWorld] " +
                    name +
                    " built a new house!"
            );
        }
    }

    private void consumeFood() {

        food -= population;

        if (food < 0) {

            food = 0;

            population--;

            if (population < 5) {
                population = 5;
            }

            System.out.println(
                    "[LivingWorld] " +
                    name +
                    " is starving!"
            );
        }
    }

    private void checkGrowth() {

        if (population >= houses * 5) {
            return;
        }

        if (food > population * 2) {

            population++;

            food -= 5;

            professions.put(
                    Profession.UNEMPLOYED,
                    professions.get(Profession.UNEMPLOYED) + 1
            );
        }

        level = Math.max(level, houses / 2 + 1);
    }

    public void reducePopulation(int amount) {

        population -= amount;

        if (population < 5) {
            population = 5;
        }
    }

    public String getName() {
        return name;
    }

    public int getPopulation() {
        return population;
    }

    public int getLevel() {
        return level;
    }

    public int getFood() {
        return food;
    }

    public int getWood() {
        return wood;
    }

    public int getStone() {
        return stone;
    }

    public int getHouses() {
        return houses;
    }

    public int getProfessionCount(Profession profession) {
        return professions.get(profession);
    }

    public void setProfessionCount(
            Profession profession,
            int amount
    ) {
        professions.put(profession, amount);
    }

    public int getX() {
        return x;
    }

    public int getZ() {
        return z;
    }
}

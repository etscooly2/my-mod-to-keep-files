package com.example.core;

import net.minecraft.server.MinecraftServer;

public class LivingWorldManager {

    private static MinecraftServer server;
    private static LivingWorldSave data;

    public static void initialize(MinecraftServer minecraftServer) {

        if (server != null) {
            return;
        }

        server = minecraftServer;

        data = new LivingWorldSave();

        data.settlements.add(
                new Settlement(
                        "First Village",
                        0,
                        0
                )
        );

        System.out.println(
                "[LivingWorld] Civilization system started!"
        );
    }

    public static void tick() {

        if (data == null) {
            return;
        }

        data.tick();

        if (data.worldAge % 24000 != 0) {
            return;
        }

        System.out.println(
                "[LivingWorld] ===== NEW DAY ====="
        );

        data.dailyUpdate();

        System.out.println(
                "[LivingWorld] Settlements: "
                        + data.settlements.size()
        );

        for (Settlement settlement : data.settlements) {

            System.out.println("-----------------------");

            System.out.println(
                    settlement.getName()
            );

            System.out.println(
                    "Population: "
                            + settlement.getPopulation()
            );

            System.out.println(
                    "Level: "
                            + settlement.getLevel()
            );

            System.out.println(
                    "Houses: "
                            + settlement.getHouses()
            );

            System.out.println(
                    "Food: "
                            + settlement.getFood()
            );

            System.out.println(
                    "Wood: "
                            + settlement.getWood()
            );

            System.out.println(
                    "Stone: "
                            + settlement.getStone()
            );
        }

        WorldEventManager.dailyTick();
    }

    public static LivingWorldSave getData() {
        return data;
    }
}

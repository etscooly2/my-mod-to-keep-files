package com.example.core;

import java.util.Random;

public class SettlementManager {

    private static final Random RANDOM = new Random();

    public static void dailyUpdate(LivingWorldSave data) {

        Settlement founder = null;

        for (Settlement settlement : data.settlements) {

            settlement.dailyUpdate(data);

            if (founder == null && settlement.getPopulation() >= 30 && data.settlements.size() < 5) {

                founder = settlement;

            }

        }

        if (founder != null) {

            int x = founder.getX() + RANDOM.nextInt(401) - 200;

            int z = founder.getZ() + RANDOM.nextInt(401) - 200;

            Settlement newVillage = new Settlement(

                    "Village " + (data.settlements.size() + 1),

                    x,

                    z

            );

            founder.reducePopulation(10);

            data.settlements.add(newVillage);

            System.out.println("[LivingWorld]");

            System.out.println("New settlement founded!");

            System.out.println("Name: " + newVillage.getName());

            System.out.println("Location: " + x + ", " + z);

        }

    }

}
